{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"paths": {
			"@workspace/env/*": ["./src/*"],
		},
		"types": ["node"],
	},
	"include": ["."],
	"exclude": ["node_modules", "dist"],
}
