{
	"name": "@workspace/env",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsdown \"src/**/*.ts\" --format esm --dts --clean",
		"dev": "tsdown \"src/**/*.ts\" --format esm --dts --watch",
		"fix": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@t3-oss/env-core": "^0.13.11",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@turbo/gen": "catalog:",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"exports": {
		".": {
			"development": {
				"types": "./src/index.ts",
				"default": "./src/index.ts"
			},
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./db": {
			"development": {
				"types": "./src/db.ts",
				"default": "./src/db.ts"
			},
			"types": "./dist/db.d.mts",
			"import": "./dist/db.mjs"
		}
	}
}
