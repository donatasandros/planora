{
	"dependencies": {
		"@t3-oss/env-core": "^0.13.11",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@turbo/gen": "^2.10.12",
		"@types/node": "^26.4.1",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2"
	},
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./db": {
			"import": "./dist/db.mjs",
			"types": "./dist/db.d.mts"
		}
	},
	"name": "@workspace/env",
	"private": true,
	"scripts": {
		"build": "tsdown \"src/**/*.ts\" --format esm --dts --clean",
		"dev": "tsdown \"src/**/*.ts\" --format esm --dts --watch",
		"fix": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"version": "0.0.0"
}
