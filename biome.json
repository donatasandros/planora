{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/routeTree.gen.ts",
			"!README.md",
			"!docker-compose.yml",
			"!promtail-config.yaml",
			"!pnpm-workspace.yaml",
			"!pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "lf",
		"indentWidth": 3,
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"includes": ["**", "!**/routeTree.gen.ts"],
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"useAwait": "off"
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded",
			"trailingCommas": "es5"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["apps/bot/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["./**", "../**"],
										"message": "Use the '@/' path alias instead of relative imports."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"tailwind": { "mergeFunctions": ["cn"], "variantFunctions": ["cva"] }
}
