{
	"name": "bot",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"build": "tsdown \"src/**/*.ts\" --format esm --clean",
		"start": "node --env-file=.env ./dist/index.mjs",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@workspace/db": "workspace:*",
		"@workspace/logger": "workspace:*",
		"@workspace/redis": "workspace:*",
		"discord.js": "^14.27.0"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"ts-node": "^10.9.2",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2"
	}
}
