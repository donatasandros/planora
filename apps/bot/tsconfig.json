{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"]
		},
		"rootDir": "./src",
		"outDir": "./dist",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"customConditions": ["development"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
